{
    "//说明": "ADAS 场地测试主控系统 - 应用配置。第一阶段由 ScenarioParser 读取。",
    "app": {
        "name": "ADASMaster",
        "version": "0.1.0",
        "language": "zh_CN",
        "theme": "dark"
    },
    "paths": {
        "devices": "config/devices.json",
        "scenarios": "scenarios/",
        "logs": "logs/",
        "data": "data/"
    },
    "network": {
        "control_subnet": "192.168.1.0/24",
        "rtk_ntrip_source": "192.168.1.20:5010",
        "comm_timeout_ms": 3000,
        "heartbeat_period_ms": 1000
    },
    "units": {
        "speed": "m/s",
        "distance": "m",
        "time": "s"
    },
    "roles": {
        "visitor":   { "level": 0, "desc": "只能查看" },
        "operator":  { "level": 1, "desc": "执行测试" },
        "engineer":  { "level": 2, "desc": "修改设备与工况" },
        "admin":     { "level": 3, "desc": "用户与系统管理" }
    }
}
